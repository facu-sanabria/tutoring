# ─── Modelo de IA ─────────────────────────────────────────
# claude-sdk = Claude con tu suscripción (Pro/Max). Sin API key: usa la sesión de
#              Claude Code de esta compu (ejecutá `claude` una vez e iniciá sesión).
# gemini     = Gemini de Google (tiene plan gratuito)
# anthropic  = Claude por API (pago por uso)
LLM_PROVIDER=claude-sdk

# Proveedor de respaldo: si el principal falla antes de empezar a responder
# (límite de uso, sesión, saturación o red), se usa este. Vacío = sin respaldo.
LLM_FALLBACK=gemini

# Claude con tu suscripción (alias: sonnet, haiku, opus; o el nombre completo del modelo)
CLAUDE_SDK_MODEL=sonnet
CLAUDE_SDK_MODEL_EVAL=sonnet
CLAUDE_SDK_MODEL_VOICE=haiku

# Gemini: creá la key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_VOICE=gemini-3.1-flash-lite
GEMINI_MODEL_EVAL=gemini-3.8-flash

# Claude por API: key en https://console.anthropic.com (requiere crédito)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_VOICE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_EVAL=claude-sonnet-5-5

# ─── Voz ──────────────────────────────────────────────────
# gemini-live = Gemini Live: voz a voz nativa, la más natural (entona, reacciona, se la
#               interrumpe hablando encima). Usa GEMINI_API_KEY; tiene plan gratuito.
# vapi        = Vapi: cadena voz → texto → IA → voz, con interrupciones. Cobra por minuto.
# browser     = voz del navegador (Chrome/Edge), gratis.
# Si el elegido no está configurado, la app usa el siguiente que sí (gemini-live → vapi → navegador).
# Si falla al conectar, la llamada ofrece el botón "Seguir con otra voz".
VOICE_PROVIDER=gemini-live

# Gemini Live. La GEMINI_API_KEY nunca llega al navegador: el servidor entrega un token
# efímero (un uso, 30 minutos) para cada llamada.
GEMINI_LIVE_MODEL=gemini-3.8-live
# auto = femenina o masculina según el cliente del escenario. O fijá una voz para todos:
# Kore, Aoede, Leda, Zephyr (femeninas) · Orus, Puck, Charon, Fenrir (masculinas). Todas hablan español.
GEMINI_LIVE_VOICE=auto
# Voces que usa "auto"
# GEMINI_LIVE_VOICE_FEMENINA=Kore
# GEMINI_LIVE_VOICE_MASCULINA=Orus

# ─── Vapi (VOICE_PROVIDER=vapi) ──────────────────────────
# PUBLIC key de Vapi (panel de Vapi → API Keys). Llega al navegador: es pública por diseño.
# NUNCA pongas acá la private key.
VAPI_PUBLIC_KEY=
# Opcional: un asistente creado en el panel de Vapi. Si está vacío, se arma uno por escenario.
VAPI_ASSISTANT_ID=
# Modelo que interpreta al cliente dentro de Vapi (lo cobra Vapi, no usa tu plan de Claude).
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-haiku-4-5-20251001
# Voces en español rioplatense (Azure). Se elige femenina o masculina según el nombre del cliente.
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_FEMENINA=es-AR-ElenaNeural
VAPI_VOICE_MASCULINA=es-AR-TomasNeural
# Transcripción (voz a texto)
VAPI_TRANSCRIBER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_LANGUAGE=es

# ─── Servidor ─────────────────────────────────────────────
PORT=3000

# ─── Avanzado (normalmente no hace falta tocar) ───────────
# Cuánto se espera a que la IA empiece a responder, en milisegundos.
# LLM_TIMEOUT_MS=45000
# Gemini 3 razona antes de responder y eso cuenta dentro del límite de tokens.
# Nivel de razonamiento (low, medium, high) y margen de tokens extra para que no llegue vacío.
# GEMINI_REASONING=low
# GEMINI_THINKING_EXTRA=4096
# Dónde se guardan la configuración y los informes (relativo a la carpeta del proyecto).
# DATA_DIR=data
# Endpoints de las APIs. Sirven para apuntar a un servidor propio o de prueba.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_LIVE_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
