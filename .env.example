# ─── Modelo de IA ─────────────────────────────────────────
# gemini    = Gemini de Google (tiene plan gratuito)
# anthropic = Claude de Anthropic (pago por uso)
LLM_PROVIDER=gemini

# Gemini: creá la key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_VOICE=gemini-3.1-flash-lite
GEMINI_MODEL_EVAL=gemini-3.8-flash

# Claude: key en https://console.anthropic.com (requiere crédito)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_VOICE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_EVAL=claude-sonnet-5

# ─── Voz ──────────────────────────────────────────────────
# browser = voz del navegador (Chrome/Edge). vapi = Vapi (a futuro)
VOICE_PROVIDER=browser
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# ─── Servidor ─────────────────────────────────────────────
PORT=3000

# ─── Avanzado (normalmente no hace falta tocar) ───────────
# Dónde se guardan la configuración y los informes (relativo a la carpeta del proyecto).
# DATA_DIR=data
# Endpoints de las APIs. Sirven para apuntar a un servidor propio o de prueba.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
